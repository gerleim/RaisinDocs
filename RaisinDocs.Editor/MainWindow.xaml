<Window x:Class="RaisinDocs.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:docs="clr-namespace:RaisinDocs;assembly=RaisinDocs"
        Title="RaisinDocs Editor"
        Icon="Assets/app.ico"
        Width="1024" Height="768"
        Background="#1E1E1E"
        Foreground="#D4D4D4"
        AllowDrop="True">
    <Window.Resources>
        <Style TargetType="docs:DocsFormattingBar"
               BasedOn="{StaticResource {x:Type docs:DocsFormattingBar}}">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="BorderBrush" Value="#3F3F3F" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#252526" Padding="4,4,0,0">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#969696" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="#2D2D30"
                                Padding="10,5,4,5"
                                Margin="0,0,1,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E42" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E" />
                                <Setter Property="Foreground" Value="#D4D4D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="3,1">
                            <TextBlock x:Name="X" Text="&#xD7;" FontSize="12" Foreground="#808080" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4E4E4E" />
                                <Setter TargetName="X" Property="Foreground" Value="#D4D4D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Click="SaveAs_Click" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem x:Name="RecentFilesMenuItem" Header="_Recent Files" SubmenuOpened="RecentFiles_SubmenuOpened">
                    <MenuItem Header="(empty)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Print..." Click="Print_Click" InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="Close _Tab" Click="CloseTab_Click" InputGestureText="Ctrl+W" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="Undo_Click" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Click="Redo_Click" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Cu_t" Click="Cut_Click" InputGestureText="Ctrl+X" />
                <MenuItem Header="_Copy" Click="Copy_Click" InputGestureText="Ctrl+C" />
                <MenuItem Header="_Paste" Click="Paste_Click" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="Select _All" Click="SelectAll_Click" InputGestureText="Ctrl+A" />
                <Separator />
                <MenuItem Header="_Find..." Click="Find_Click" InputGestureText="Ctrl+F" />
                <MenuItem Header="Find and _Replace..." Click="FindReplace_Click" InputGestureText="Ctrl+H" />
            </MenuItem>
            <MenuItem Header="_View" SubmenuOpened="View_SubmenuOpened">
                <MenuItem x:Name="TocMenuItem" Header="Table of _Contents" Click="Toc_Click" IsCheckable="True" InputGestureText="Ctrl+T" />
                <MenuItem x:Name="MinimapMenuItem" Header="Mi_nimap" Click="Minimap_Click" IsCheckable="True" />
                <MenuItem x:Name="PageBreaksMenuItem" Header="_Page Breaks" Click="PageBreaks_Click" IsCheckable="True" />
            </MenuItem>
        </Menu>
        <TabControl x:Name="TabControl" SelectionChanged="TabControl_SelectionChanged" />
    </DockPanel>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ApplicationCommands.Open}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.SaveAs}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static ApplicationCommands.Close}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{x:Static ApplicationCommands.Print}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="New_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="Open_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="Save_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="SaveAs_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="CloseTab_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.Print}" Executed="Print_Click" />
    </Window.CommandBindings>
</Window>
